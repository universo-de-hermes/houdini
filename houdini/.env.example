# =============================================
# Houdini - Variables de Entorno
# Copia este archivo como .env y rellena tus claves
# =============================================

# === General ===
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# === OpenRouter (LLM fallback) ===
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# === Anthropic (Claude Opus 5 - primario) ===
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# === PostgreSQL ===
POSTGRES_USER=houdini
POSTGRES_PASSWORD=houdini_secret
POSTGRES_DB=houdini_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Telegram ===
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# === Google OAuth (Gmail, Calendar, Drive, Sheets) ===
GOOGLE_CLIENT_ID=tu_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# === TTS (Salome) ===
TTS_ENABLED=true
TTS_VOICE=es-CO-SalomeNeural
